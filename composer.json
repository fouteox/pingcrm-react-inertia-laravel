{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.10",
        "fakerphp/faker": "^1.24.1",
        "inertiajs/inertia-laravel": "^3.3.3",
        "laravel-lang/common": "^6.8.0",
        "laravel/framework": "^13.30.1",
        "laravel/octane": "^2.19.1",
        "laravel/reverb": "^1.11.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/scout": "^11.6.1",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "dev-next",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.7.1",
        "laravel/breeze": "^2.4.2",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.31.0",
        "laravel/sail": "^1.67.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.4",
        "pestphp/pest-plugin-browser": "^5.0.1",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "composer install",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "vp install",
            "vp build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "vp exec bunx concurrently -c \"#c4b5fd,#fdba74,#93c5fd\" \"php artisan queue:work\" \"bun run dev\" \"php artisan schedule:work\" --names=queue,vite,scheduler --kill-others"
        ],
        "lint": [
            "pint"
        ],
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.10"
        },
        "platform-check": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
